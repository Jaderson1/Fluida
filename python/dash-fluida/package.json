{
  "name": "dash-fluida-frontend",
  "private": true,
  "version": "0.2.0",
  "description": "Private frontend build for the dash-fluida component. The generated bundle is included in the dash-fluida Python package under the dash_fluida module.",
  "type": "module",
  "scripts": {
    "build": "tsup && node scripts/copy-bundle.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fluida/core": "workspace:*"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/prop-types": "^15.7.15", 
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^29.1.1",
    "prop-types": "^15.8.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
